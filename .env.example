# External Neo4j connection (for example Neo4j Aura).
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-now
POSTGRES_DB=lctrend
POSTGRES_USER=lctrend
POSTGRES_PASSWORD=change-me-now
POSTGRES_PORT=5432
FRONTEND_PORT=5188
# Public domain of the web UI, e.g. signals.example.ru (empty = localhost
# only). Set FRONTEND_HOST=0.0.0.0 to accept connections from outside.
LCTREND_DOMAIN=
FRONTEND_HOST=127.0.0.1
GITHUB_TOKEN=
# hh.ru vacancies (economic layer): application token from dev.hh.ru.
HH_ACCESS_TOKEN=
# Free key: https://openalex.org/settings/api (recommended for bulk loading).
# Sent only by the backend; do not put it in VITE_* variables.
OPENALEX_API_KEY=
# Optional contact email; does not replace the API key.
OPENALEX_MAILTO=
LCTREND_CONFIG_DIR=
LCTREND_RAW_DIR=artifacts/raw
# LLM: GigaChat
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=
# Russian Trusted Root CA for GigaChat TLS. Docker sets it itself
# (compose.yaml); for a local run: certs/gigachat-ca-bundle.pem
GIGACHAT_CA_BUNDLE_FILE=
# Several keys at once: a JSON list of keys with client_id (see
# gigachat-keys.example.json). Replaces GIGACHAT_CREDENTIALS; each key runs
# its own "workers" requests, so N keys process N times as many at once.
# Docker: /app/artifacts/ingestion/gigachat-keys.json
GIGACHAT_KEYS_FILE=
# For LLM_PROVIDER=openai_compatible (unused by GigaChat):
LLM_BASE_URL=
LLM_API_KEY=
LLM_CA_BUNDLE_FILE=
# Models, strongest first. Empty = default ladder from resources/llm.json:
# GigaChat-3-Ultra -> GigaChat-2-Max -> GigaChat-2-Pro -> GigaChat-2
# A model with no tokens left (HTTP 402 or low /balance) is skipped.
LLM_MODEL_LADDER=
# Optional: pin one model, or separate models for the two processing stages.
LLM_MODEL=
LLM_EXTRACT_MODEL=
LLM_REVIEW_MODEL=
# Bulk ingestion: documents processed concurrently per job (1..16, empty =
# runtime.json ingestion.workers) and concurrent LLM requests (empty =
# llm.json: 1 for GigaChat personal accounts, 4 for OpenAI-compatible).
# With a key pool, keep LCTREND_WORKERS above the sum of the keys' workers,
# or the extra keys wait idle. Per-key workers override LLM_MAX_CONCURRENCY.
LCTREND_WORKERS=
LLM_MAX_CONCURRENCY=
# Entity dedup embeddings: gigachat (default, uses the
# GIGACHAT_* credentials above) or transformers (local model).
# Empty model = EmbeddingsGigaR / sentence-transformers/all-MiniLM-L6-v2.
DEDUP_EMBEDDING_PROVIDER=
DEDUP_EMBEDDING_MODEL=
# Optional 0/1 override of resolver.json semantic.use_in_llm:
DEDUP_IN_LLM=
# Logging: console level, log file path and its level (file keeps DEBUG)
LCTREND_LOG_LEVEL=INFO
LCTREND_LOG_FILE=logs/lctrend.log
LCTREND_LOG_FILE_LEVEL=DEBUG
# Seconds between "LLM stats" summary lines in the log (0 = off). The same
# numbers, per key and stage, are served at GET /api/llm/stats.
LCTREND_LLM_STATS_SECONDS=60
# Extra Host names the web UI answers to, comma-separated (localhost and
# 127.0.0.1 are always allowed). Needed only to open the UI by another name.
LCTREND_ALLOWED_HOSTS=
# Seconds a stopping web server lets running documents finish before
# their jobs are recorded as interrupted (default 8, below Docker's 10 s).
LCTREND_SHUTDOWN_GRACE_SECONDS=
# Hours an upload folder is kept after upload (the raw snapshot stays);
# folders of running jobs are never removed. Default 24.
LCTREND_UPLOAD_TTL_HOURS=
