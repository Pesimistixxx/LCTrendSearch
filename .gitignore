artifacts/training/
# Modeling runs are regenerated. The presented run is shown in full: models,
# training set, LLM labels, scores and the merge journal. Only the large
# exports stay local (subgraphs 1.1 GB, history 59 MB, reviewer sheets).
artifacts/modeling/*
!artifacts/modeling/2026-09-29-dedup/
!artifacts/modeling/dedup-090.json
artifacts/modeling/2026-09-29-dedup/*.log
artifacts/modeling/2026-09-29-dedup/dataset/subgraphs.jsonl
artifacts/modeling/2026-09-29-dedup/dataset/history.csv
artifacts/modeling/2026-09-29-dedup/dataset/review.reviewer_*.csv
artifacts/modeling/2026-09-29-dedup/dataset/graph-*/
logs/
# Raw source snapshots are regenerated by crawls; third-party PDFs and crawl
# data do not belong in history (audit NEW-1).
artifacts/raw/
artifacts/llm-cache/
artifacts/pytest-*/
.test-tmp-*/

# Local graph dumps and the offline graph view (large, regenerable).
artifacts/backups/
artifacts/graph-view/
artifacts/full-subgraphs-2026-09-29.jsonl
# Leftovers of test runs with a locked ACL (git cannot read them).
artifacts/economic-review-tests-*/
artifacts/test-*/
